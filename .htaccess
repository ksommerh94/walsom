RewriteEngine On

# 1. Forzar HTTPS y WWW en una sola regla para eficiencia
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} !^www\. [NC]
RewriteRule ^(.*)$ https://www.walsom.com.co/$1 [L,R=301]

# 2. Manejo de caché (Opcional pero recomendado para velocidad)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
